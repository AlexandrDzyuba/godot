<?xml version="1.0" encoding="UTF-8" ?>
<class name="CSGModifierValue" inherits="Resource" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../doc/class.xsd">
	<brief_description>A scalar source used by a CSG channel override.</brief_description>
	<description>Selects one semantic or topology value, then applies scale, bias, and an optional range limit.</description>
	<members>
		<member name="bias" type="float" setter="set_bias" getter="get_bias" default="0.0">Value added after scaling.</member>
		<member name="clamp_enabled" type="bool" setter="set_clamp_enabled" getter="is_clamp_enabled" default="false">Limits the result to [member min_value] and [member max_value].</member>
		<member name="constant_value" type="float" setter="set_constant_value" getter="get_constant_value" default="0.0">Value used for [constant SOURCE_CONSTANT].</member>
		<member name="max_value" type="float" setter="set_max_value" getter="get_max_value" default="1.0">Upper range limit.</member>
		<member name="min_value" type="float" setter="set_min_value" getter="get_min_value" default="0.0">Lower range limit.</member>
		<member name="scale" type="float" setter="set_scale" getter="get_scale" default="1.0">Source multiplier.</member>
		<member name="source" type="int" setter="set_source" getter="get_source" enum="CSGModifierValue.Source" default="0">Semantic value to write.</member>
	</members>
	<constants>
		<constant name="SOURCE_CONSTANT" value="0" enum="Source">A configured constant.</constant>
		<constant name="SOURCE_BRUSH_ID" value="1" enum="Source">Ordinal CSG brush/source ID.</constant>
		<constant name="SOURCE_FACE_ID" value="2" enum="Source">Stable face ID.</constant>
		<constant name="SOURCE_SOURCE_FACE_ID" value="3" enum="Source">Original source face ID.</constant>
		<constant name="SOURCE_SURFACE_ID" value="4" enum="Source">Surface ID.</constant>
		<constant name="SOURCE_MATERIAL_ID" value="5" enum="Source">Material ID.</constant>
		<constant name="SOURCE_FACE_GENERATION" value="6" enum="Source">Face generation tag.</constant>
		<constant name="SOURCE_TRIANGLE_EDGE_DISTANCE_0" value="7" enum="Source">Barycentric distance to real mesh edge 0. Boundary and sharp edges are included; coplanar triangulation edges are ignored.</constant>
		<constant name="SOURCE_TRIANGLE_EDGE_DISTANCE_1" value="8" enum="Source">Barycentric distance to real mesh edge 1. Boundary and sharp edges are included; coplanar triangulation edges are ignored.</constant>
		<constant name="SOURCE_TRIANGLE_EDGE_DISTANCE_2" value="9" enum="Source">Barycentric distance to real mesh edge 2. Boundary and sharp edges are included; coplanar triangulation edges are ignored.</constant>
		<constant name="SOURCE_BOUNDARY_EDGE" value="10" enum="Source">One for vertices incident to a boundary edge.</constant>
		<constant name="SOURCE_SHARP_EDGE" value="11" enum="Source">One for vertices incident to a sharp edge.</constant>
	</constants>
</class>
